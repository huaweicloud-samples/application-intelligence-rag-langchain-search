# 华为云 RAG 环境变量配置示例
# 复制为 .env 并填写实际值

# ============ CSS 配置 ============
CSS_ENDPOINT=xxxx.css.huaweicloud.com
CSS_USERNAME=admin
CSS_PASSWORD=PLACEHOLDER-YOUR-CSS-PASSWORD

# ============ 华为云认证 ============
HUAWEI_CLOUD_AK=your_access_key
HUAWEI_CLOUD_SECRET=your_secret_key
HUAWEI_REGION=cn-north-4

# ============ ModelArts 配置 ============
# 推理端点 (需要在 ModelArts 申请模型后获取)
HUAWEI_MODELARTS_ENDPOINT=https://modelarts.cn-north-4.myhuaweicloud.com/v1/infer/xxxx
HUAWEI_EMBEDDING_ENDPOINT=https://modelarts.cn-north-4.myhuaweicloud.com/v1/infer/xxxx
